{
  "name": "splitviewer",
  "version": "0.2.4",
  "type": "module",
  "description": "Shareable, privacy-first public dashboards for Splitwise groups. First names only, EU-hosted, revocable in one click.",
  "keywords": [
    "splitwise",
    "dashboard",
    "privacy",
    "cloudflare-workers",
    "hono",
    "og-image"
  ],
  "homepage": "https://splitviewer.mattiapanzeri.workers.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panz3r/splitviewer.git"
  },
  "bugs": {
    "url": "https://github.com/panz3r/splitviewer/issues/new?template=report.yml"
  },
  "author": {
    "name": "Mattia Panzeri",
    "url": "https://github.com/panz3r"
  },
  "license": "LGPL-3.0-only",
  "private": true,
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "setup-local": "bash scripts/setup-local.sh",
    "chromium:install": "npx @puppeteer/browsers install chromium@latest",
    "chromium:launch": "npx @puppeteer/browsers launch chromium --detached -- --remote-debugging-port=9222",
    "test": "vitest run",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "@cf-wasm/og": "^0.5.0",
    "hono": "^4.13.16",
    "nanoid": "^6.0.2",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.110.0"
  }
}
