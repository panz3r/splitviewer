{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "splitviewer",
  "main": "src/index.tsx",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "vars": {
    // Your PROD Splitwise OAuth app's client id (its callback URL must be
    // https://<your-worker-domain>/auth/callback).
    "SPLITWISE_CLIENT_ID": "REPLACE_ME_SPLITWISE_CLIENT_ID",
    // Repo links for the in-app "Report an issue" footer/home/support links.
    // Point this at YOUR fork so your users report to your tracker; the
    // release workflow injects the GitHub repository automatically.
    "REPO_URL": "https://github.com/panz3r/splitviewer"
  },
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": [
        "**/*.wasm"
      ],
      "fallthrough": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "splitviewer",
      // Stamp the real id from:  wrangler d1 create splitviewer --jurisdiction eu
      "database_id": "REPLACE_ME_DATABASE_ID"
    }
  ]
}